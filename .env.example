# Kafka / Redpanda
KAFKA_BROKERS=redpanda:9092
TOPIC_RAW=logs.raw
TOPIC_SECURITY=logs.security
TOPIC_DLQ=logs.dlq
TOPIC_RAW_PARTITIONS=12
TOPIC_SECURITY_PARTITIONS=3

# Postgres
PG_DSN=postgres://logs:logs@postgres:5432/logs
POSTGRES_USER=logs
POSTGRES_PASSWORD=logs
POSTGRES_DB=logs

# Indexer
WORKERS=4
WRITE_STRATEGY=batched
BATCH_SIZE=1000
BATCH_MAX_AGE_MS=250
QUEUE_MAX=20000
PG_POOL_MAX=6

# Producer
PRODUCER_RATE=5000
PRODUCER_SERVICES=8
PRODUCER_DURATION=0
PRODUCER_SCENARIOS=all

# Alerter
ALERT_SINK=stdout
ALERT_DEDUP_WINDOW_S=300

# Misc
LOG_LEVEL=INFO
METRICS_PORT=9101
